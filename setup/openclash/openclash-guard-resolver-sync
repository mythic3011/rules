#!/bin/sh
# OpenClash Guard AdGuard Home resolver-to-nft synchronization helper.
set -eu

RS_FAMILY=inet
RS_TABLE=openclash_guard
RS_CHAIN=forward
RS_V4_SET=resolver_sync_v4
RS_V6_SET=resolver_sync_v6
RS_V4_SET_COMMENT=openclash-guard:resolver-sync-v4-set
RS_V6_SET_COMMENT=openclash-guard:resolver-sync-v6-set
RS_V4_RULE_COMMENT=openclash-guard:resolver-sync-v4
RS_V6_RULE_COMMENT=openclash-guard:resolver-sync-v6

rs_state() { printf '%s\n' "${GUARD_RESOLVER_SYNC_STATE_FILE:-/var/run/openclash-guard/resolver-sync.json}"; }
rs_cache() { printf '%s\n' "${GUARD_RESOLVER_SYNC_CACHE_FILE:-/var/lib/openclash-guard/resolver-sync.cache}"; }
rs_cursor() { printf '%s\n' "${GUARD_RESOLVER_SYNC_CURSOR_FILE:-/var/lib/openclash-guard/resolver-sync.cursor}"; }
rs_rules() { printf '%s\n' "${GUARD_RESOLVER_SYNC_RULES_FILE:-/etc/openclash-guard/openclash-guard-resolver-sync.rules}"; }
rs_policy() { printf '%s\n' "${GUARD_POLICY_FILE:-/etc/openclash-guard/openclash-guard.json}"; }
rs_uint() { case ${1:-} in ''|*[!0-9]*) return 1;; *) return 0;; esac; }
rs_iface_ok() { case ${1:-} in ''|*[!A-Za-z0-9_.:@-]*) return 1;; esac; }

rs_direct_iface() {
    x=${GUARD_DIRECT_WAN_IFACE:-}
    if [ -z "$x" ] && command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
        j=$(ubus call network.interface.wan status 2>/dev/null) || j=
        [ -z "$j" ] || x=$(jsonfilter -s "$j" -e '@.l3_device' 2>/dev/null) || x=
    fi
    if [ -z "$x" ] && command -v uci >/dev/null 2>&1; then
        x=$(uci -q get network.wan.device 2>/dev/null) || x=
    fi
    if [ -z "$x" ] && command -v ip >/dev/null 2>&1; then
        x=$(ip -4 route show default 2>/dev/null | awk '$1=="default" {for(i=1;i<=NF;i++) if($i=="dev"&&i<NF){print $(i+1);exit}}') || x=
    fi
    rs_iface_ok "$x" || return 1
    printf '%s\n' "$x"
}

rs_ipv4() {
    printf '%s\n' "$1" | awk -F. 'NF!=4{exit 1}{for(i=1;i<=4;i++) if($i!~/^[0-9]+$/||$i>255) exit 1}'
}
rs_ipv6() {
    printf '%s\n' "$1" | awk '
      function ok(x){return length(x)>=1&&length(x)<=4&&x~/^[0-9A-Fa-f]+$/}
      {s=$0;if(s==""||s~/[^0-9A-Fa-f:]/)exit 1;c=gsub(/::/,"::",s);if(c>1)exit 1;z=index(s,"::")>0;n=split(s,a,":");u=0;for(i=1;i<=n;i++){if(a[i]=="")continue;if(!ok(a[i]))exit 1;u++}if(z){if(u>=8)exit 1}else if(u!=8)exit 1}'
}

rs_rules_check() {
    r=$(rs_rules); p=$(rs_policy)
    [ -f "$r" ] && [ ! -L "$r" ] && [ -f "$p" ] && [ ! -L "$p" ] || return 1
    command -v jsonfilter >/dev/null 2>&1 || return 1
    rev=$(jsonfilter -i "$p" -e '@.revision' 2>/dev/null) || return 1
    [ "${#rev}" -eq 64 ] || return 1; case $rev in *[!0-9a-f]*) return 1;; esac
    awk -v want="$rev" '
      BEGIN{h=0;r=0;s=0;q=0;b=0}
      /^#/ {if($0=="# openclash-guard-resolver-sync-rules/v1")h=1;next}
      /^[[:space:]]*$/ {next}
      $1=="policy-revision" {if(NF!=2||$2!=want) b=1;r++;next}
      $1=="source" {if(NF!=4||length($4)!=40||$4!~/^[0-9a-f]+$/)b=1;s++;next}
      $1=="selector" {if(NF!=4||$3!~/^(exact|suffix)$/||$4=="")b=1;q++;next}
      $1=="exclude" {if(NF!=3)b=1;next}
      {b=1}
      END{exit !(h&&r==1&&s>0&&q>0&&!b)}' "$r"
}

rs_domain_match() {
    q=$(printf '%s' "$1" | tr 'A-Z' 'a-z'); q=${q%.}; [ -n "$q" ] || return 1
    while IFS=' ' read -r kind service mode value extra; do
        [ "$kind" = selector ] || continue; [ -z "${extra:-}" ] || return 1
        case $mode in exact) [ "$q" = "$value" ] && return 0;; suffix) case $q in "$value"|*."$value") return 0;; esac;; esac
    done < "$(rs_rules)"
    return 1
}

rs_url() {
    [ -z "${GUARD_AGH_QUERYLOG_URL:-}" ] || { printf '%s\n' "$GUARD_AGH_QUERYLOG_URL"; return; }
    n=${GUARD_RESOLVER_SYNC_QUERYLOG_LIMIT:-1000}; rs_uint "$n" && [ "$n" -le 5000 ] || return 1
    printf 'http://127.0.0.1:3000/control/querylog?limit=%s\n' "$n"
}
rs_fetch() {
    out=$1
    if [ -n "${GUARD_RESOLVER_SYNC_QUERYLOG_FILE:-}" ]; then
        [ -f "$GUARD_RESOLVER_SYNC_QUERYLOG_FILE" ] && [ ! -L "$GUARD_RESOLVER_SYNC_QUERYLOG_FILE" ] || return 1
        cp "$GUARD_RESOLVER_SYNC_QUERYLOG_FILE" "$out"; return
    fi
    command -v curl >/dev/null 2>&1 || return 1; u=$(rs_url) || return 1
    case $u in http://127.0.0.1:*|http://localhost:*|http://\[::1\]:*|https://*) ;; *) return 1;; esac
    set -- -fSs --max-redirs 0 --connect-timeout 3 --max-time 10 --noproxy '*' --proxy ''
    if [ -n "${GUARD_AGH_NETRC_FILE:-}" ]; then
        [ -f "$GUARD_AGH_NETRC_FILE" ] && [ ! -L "$GUARD_AGH_NETRC_FILE" ] || return 1
        set -- "$@" --netrc-file "$GUARD_AGH_NETRC_FILE"
    fi
    curl "$@" -o "$out" "$u" || return 1
    m=${GUARD_RESOLVER_SYNC_MAX_QUERYLOG_BYTES:-4194304}; rs_uint "$m" && [ "$m" -ge 1024 ] && [ "$m" -le 16777216 ] || return 1
    z=$(wc -c < "$out" | tr -d ' '); rs_uint "$z" && [ "$z" -gt 0 ] && [ "$z" -le "$m" ]
}

rs_entries() {
    f=$1; out=$2; command -v jsonfilter >/dev/null 2>&1 || return 1
    t=$(jsonfilter -i "$f" -t '@.data' 2>/dev/null) || return 1; [ "$t" = array ] || return 1
    : > "$out"; jsonfilter -i "$f" -e '@.data[*]' > "$out" 2>/dev/null || true
}
rs_hash() { printf '%s' "$1" | sha256sum | awk '{print $1}'; }
rs_cursor_read() {
    f=$(rs_cursor); [ -f "$f" ] && [ ! -L "$f" ] || return 1; x=$(head -n1 "$f") || return 1
    [ "$x" = EMPTY ] && { printf '%s\n' "$x"; return; }; [ "${#x}" -eq 64 ] || return 1; case $x in *[!0-9a-f]*) return 1;; esac; printf '%s\n' "$x"
}
rs_select_new() {
    entries=$1; out=$2; next=$3; : > "$out"; old=$(rs_cursor_read 2>/dev/null) || old=; first=; found=0; count=0
    while IFS= read -r e; do
        [ -n "$e" ] || continue; h=$(rs_hash "$e") || return 1; count=$((count+1)); [ -n "$first" ] || first=$h
        if [ -n "$old" ] && [ "$old" != EMPTY ] && [ "$h" = "$old" ]; then found=1; break; fi
        printf '%s\n' "$e" >> "$out"
    done < "$entries"
    [ "$count" -eq 0 ] && cur=EMPTY || cur=$first; printf '%s\n' "$cur" > "$next"
    [ -n "$old" ] || { : > "$out"; return 10; }; [ "$old" = EMPTY ] && return 0
    [ "$count" -gt 0 ] && [ "$found" -eq 1 ] || { : > "$out"; return 10; }
}

rs_answers() {
    e=$1; now=$2; out=$3; tmp=$4
    q=$(jsonfilter -s "$e" -e '@.question.name' 2>/dev/null) || q=
    [ -n "$q" ] || q=$(jsonfilter -s "$e" -e '@.question.host' 2>/dev/null) || q=
    [ -n "$q" ] && rs_domain_match "$q" || return 0
    : > "$tmp"; jsonfilter -s "$e" -e '@.answer[*]' > "$tmp" 2>/dev/null || true
    while IFS= read -r a; do
        [ -n "$a" ] || continue
        typ=$(jsonfilter -s "$a" -e '@.type' 2>/dev/null) || continue; val=$(jsonfilter -s "$a" -e '@.value' 2>/dev/null) || continue; ttl=$(jsonfilter -s "$a" -e '@.ttl' 2>/dev/null) || continue
        rs_uint "$ttl" || continue; safe=${GUARD_RESOLVER_SYNC_TTL_SAFETY_SECONDS:-${GUARD_RESOLVER_SYNC_INTERVAL:-30}}; max=${GUARD_RESOLVER_SYNC_MAX_TTL:-300}
        rs_uint "$safe" && rs_uint "$max" && [ "$max" -le 3600 ] || return 1; [ "$ttl" -le "$max" ] || ttl=$max; [ "$ttl" -gt "$safe" ] || continue; exp=$((now+ttl-safe))
        case $typ in A) rs_ipv4 "$val" && printf '4 %s %s\n' "$val" "$exp" >> "$out";; AAAA) rs_ipv6 "$val" && printf '6 %s %s\n' "$val" "$exp" >> "$out";; esac
    done < "$tmp"
}

rs_merge_cache() {
    add=$1; now=$2; out=$3; old=$(rs_cache); in=${out}.in.$$; uns=${out}.uns.$$
    : > "$in" || return 1
    if [ -f "$old" ]; then [ ! -L "$old" ] || { rm -f "$in"; return 1; }; cat "$old" >> "$in" || { rm -f "$in"; return 1; }; fi
    [ ! -f "$add" ] || cat "$add" >> "$in" || { rm -f "$in"; return 1; }
    awk -v now="$now" 'NF==0{next} NF!=3||($1!=4&&$1!=6)||$3!~/^[0-9]+$/{bad=1;next} $3>now{k=$1" "$2;if(!(k in x)||$3>x[k])x[k]=$3} END{if(bad)exit 2;for(k in x)print k" "x[k]}' "$in" > "$uns" || { rm -f "$in" "$uns"; return 1; }
    sort "$uns" > "$out" || { rm -f "$in" "$uns"; return 1; }; rm -f "$in" "$uns"
}

rs_set_ok() {
    n=$1; typ=$2; c=$3; x=$(nft list set "$RS_FAMILY" "$RS_TABLE" "$n" 2>/dev/null) || return 1
    printf '%s\n' "$x" | awk -v t="$typ" -v c="$c" '$1=="type"&&$2==t{a=1}$1=="flags"&&index($0,"timeout"){b=1}index($0,"comment \""c"\""){d=1}END{exit !(a&&b&&d)}'
}
rs_structure() {
    iface=$1; batch=$2; nft list table "$RS_FAMILY" "$RS_TABLE" >/dev/null 2>&1 || return 1; chain=$(nft -a list chain "$RS_FAMILY" "$RS_TABLE" "$RS_CHAIN" 2>/dev/null) || return 1; : > "$batch"
    if nft list set "$RS_FAMILY" "$RS_TABLE" "$RS_V4_SET" >/dev/null 2>&1; then rs_set_ok "$RS_V4_SET" ipv4_addr "$RS_V4_SET_COMMENT" || return 1; else printf 'add set %s %s %s { type ipv4_addr; flags timeout; comment "%s"; }\n' "$RS_FAMILY" "$RS_TABLE" "$RS_V4_SET" "$RS_V4_SET_COMMENT" >> "$batch"; fi
    if nft list set "$RS_FAMILY" "$RS_TABLE" "$RS_V6_SET" >/dev/null 2>&1; then rs_set_ok "$RS_V6_SET" ipv6_addr "$RS_V6_SET_COMMENT" || return 1; else printf 'add set %s %s %s { type ipv6_addr; flags timeout; comment "%s"; }\n' "$RS_FAMILY" "$RS_TABLE" "$RS_V6_SET" "$RS_V6_SET_COMMENT" >> "$batch"; fi
    printf '%s\n' "$chain" | awk -v a="$RS_V4_RULE_COMMENT" -v b="$RS_V6_RULE_COMMENT" '(index($0,"comment \""a"\"")||index($0,"comment \""b"\""))&&match($0,/# handle [0-9]+/){h=substr($0,RSTART+9);gsub(/[^0-9].*/,"",h);if(h!="")print h}' > "${batch}.h" || return 1
    while IFS= read -r h; do [ -z "$h" ] || printf 'delete rule %s %s %s handle %s\n' "$RS_FAMILY" "$RS_TABLE" "$RS_CHAIN" "$h" >> "$batch"; done < "${batch}.h"; rm -f "${batch}.h"
    printf 'add rule %s %s %s oifname "%s" ip daddr @%s reject comment "%s"\n' "$RS_FAMILY" "$RS_TABLE" "$RS_CHAIN" "$iface" "$RS_V4_SET" "$RS_V4_RULE_COMMENT" >> "$batch"
    printf 'add rule %s %s %s oifname "%s" ip6 daddr @%s reject comment "%s"\n' "$RS_FAMILY" "$RS_TABLE" "$RS_CHAIN" "$iface" "$RS_V6_SET" "$RS_V6_RULE_COMMENT" >> "$batch"
    nft -f "$batch"
}
rs_apply() {
    cache=$1; now=$2; batch=$3; : > "$batch"; printf 'flush set %s %s %s\nflush set %s %s %s\n' "$RS_FAMILY" "$RS_TABLE" "$RS_V4_SET" "$RS_FAMILY" "$RS_TABLE" "$RS_V6_SET" >> "$batch"
    while IFS=' ' read -r fam ip exp extra; do [ -z "${extra:-}" ] || return 1; [ -n "$fam" ] || continue; rs_uint "$exp" && [ "$exp" -gt "$now" ] || continue; timeout=$((exp-now)); case $fam in 4) rs_ipv4 "$ip" || return 1; setn=$RS_V4_SET;; 6) rs_ipv6 "$ip" || return 1; setn=$RS_V6_SET;; *) return 1;; esac; printf 'add element %s %s %s { %s timeout %ss }\n' "$RS_FAMILY" "$RS_TABLE" "$setn" "$ip" "$timeout" >> "$batch"; done < "$cache"
    nft -f "$batch"
}

rs_atomic_line() { d=$1; v=$2; mkdir -p "$(dirname "$d")" || return 1; t=$(mktemp "${d}.tmp.XXXXXX") || return 1; printf '%s\n' "$v" > "$t" || { rm -f "$t"; return 1; }; chmod 0600 "$t" 2>/dev/null || true; mv -f "$t" "$d"; }
rs_publish_cache() { src=$1; d=$(rs_cache); mkdir -p "$(dirname "$d")" || return 1; t=$(mktemp "${d}.tmp.XXXXXX") || return 1; cat "$src" > "$t" || { rm -f "$t"; return 1; }; chmod 0600 "$t" 2>/dev/null || true; mv -f "$t" "$d"; }
rs_state_write() {
    status=$1; reason=$2; iface=${3:-}; now=${4:-$(date +%s)}; d=$(rs_state); mkdir -p "$(dirname "$d")" || return 1; t=$(mktemp "${d}.tmp.XXXXXX") || return 1
    printf '{"schemaVersion":1,"helper":"openclash-guard-resolver-sync","backend":"adguardhome-resolver-sync","status":"%s","pid":%s,"updatedAtEpoch":%s,"reason":"%s","nft":{"family":"inet","table":"openclash_guard","chain":"forward","ipv4Set":"resolver_sync_v4","ipv6Set":"resolver_sync_v6","directInterface":"%s"}}\n' "$status" "$$" "$now" "$reason" "$iface" > "$t"
    chmod 0600 "$t" 2>/dev/null || true; mv -f "$t" "$d"
}
rs_fail() { rs_state_write degraded "$1" "${2:-}" "$(date +%s)" || rm -f "$(rs_state)"; return 1; }

rs_cycle() {
    rs_rules_check || { rs_fail rules-invalid; return 1; }; command -v nft >/dev/null 2>&1 || { rs_fail nft-unavailable; return 1; }; iface=$(rs_direct_iface 2>/dev/null) || { rs_fail direct-interface-unavailable; return 1; }; now=$(date +%s); rs_uint "$now" || { rs_fail clock-invalid "$iface"; return 1; }
    w=$(mktemp -d "${TMPDIR:-/tmp}/openclash-guard-resolver-sync.XXXXXX") || { rs_fail temp-unavailable "$iface"; return 1; }; q=$w/q.json; entries=$w/entries; new=$w/new; rec=$w/records; ans=$w/answers; next=$w/next; cache=$w/cache; sb=$w/s.nft; ub=$w/u.nft; : > "$rec"
    if ! rs_fetch "$q" || ! rs_entries "$q" "$entries"; then rm -rf "$w"; rs_fail querylog-unavailable "$iface"; return 1; fi
    rc=0; rs_select_new "$entries" "$new" "$next" || rc=$?
    if [ "$rc" -eq 10 ]; then
        if ! rs_merge_cache /dev/null "$now" "$cache" || ! rs_structure "$iface" "$sb" || ! rs_apply "$cache" "$now" "$ub" || ! rs_publish_cache "$cache" || ! rs_atomic_line "$(rs_cursor)" "$(cat "$next")"; then rm -rf "$w"; rs_fail baseline-failed "$iface"; return 1; fi
        rm -rf "$w"; rs_state_write warming cursor-baseline "$iface" "$now"; return 0
    fi
    [ "$rc" -eq 0 ] || { rm -rf "$w"; rs_fail cursor-invalid "$iface"; return 1; }
    while IFS= read -r e; do [ -n "$e" ] || continue; rs_answers "$e" "$now" "$rec" "$ans" || { rm -rf "$w"; rs_fail querylog-parse-failed "$iface"; return 1; }; done < "$new"
    if ! rs_merge_cache "$rec" "$now" "$cache" || ! rs_structure "$iface" "$sb" || ! rs_apply "$cache" "$now" "$ub"; then rm -rf "$w"; rs_fail nft-update-failed "$iface"; return 1; fi
    if ! rs_publish_cache "$cache" || ! rs_atomic_line "$(rs_cursor)" "$(cat "$next")"; then rm -rf "$w"; rs_fail state-publish-failed "$iface"; return 1; fi
    rm -rf "$w"; rs_state_write ready ok "$iface" "$now"
}

main() {
    case ${1:-run} in
      check-rules) rs_rules_check;;
      once) rs_cycle;;
      run) i=${GUARD_RESOLVER_SYNC_INTERVAL:-30}; rs_uint "$i" && [ "$i" -ge 5 ] && [ "$i" -le 300 ] || return 2; trap 'rm -f "$(rs_state)"; exit 0' INT TERM HUP; while :; do rs_cycle || true; sleep "$i"; done;;
      -h|--help|help) printf '%s\n' 'usage: openclash-guard-resolver-sync run|once|check-rules';;
      *) return 2;;
    esac
}
main "$@"
