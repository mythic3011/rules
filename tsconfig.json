{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "dist"
  },
  "include": [
    "internal/typescript/**/*.ts",
    "tests/**/*.ts"
  ]
}
