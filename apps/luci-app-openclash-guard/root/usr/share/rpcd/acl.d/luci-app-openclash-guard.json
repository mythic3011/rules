{
  "luci-app-openclash-guard": {
    "description": "Grant LuCI access to OpenClash Guard configuration and diagnostics",
    "read": {
      "uci": [ "openclash_guard", "openclash_guard_devices" ],
      "ubus": {
        "luci.openclash-guard": [ "getStatus", "getRegions", "getHistory", "trace" ],
        "luci.openclash-guard-devices": [ "getCatalog", "getDevices" ]
      }
    },
    "write": {
      "uci": [ "openclash_guard", "openclash_guard_devices" ],
      "ubus": {
        "luci.openclash-guard": [ "probeProfile", "clearHistory" ]
      }
    }
  }
}
