#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

PROG='/usr/libexec/openclash-guard/egress-monitor'
CONFIG='openclash_guard'

start_service() {
	[ "$(uci -q get "$CONFIG.monitoring.enabled" 2>/dev/null || true)" = 1 ] || return 0
	[ -x "$PROG" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
